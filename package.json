{
    "name": "chuoauth",
    "version": "0.1.0",
    "private": true,
    "description": "中央大学の学生Googleアカウントで本人確認し、署名済みJWTを発行する独立認証プロバイダ",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "generate-keys": "tsx scripts/generate-keys.ts",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "dotenv": "^18.0.9",
        "google-auth-library": "^11.3.2",
        "hono": "^4.13.16",
        "jose": "^6.2.14",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@12.15.0"
}
