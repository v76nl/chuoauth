# サーバー設定
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# 発行するJWTの iss (省略時は APP_BASE_URL)
TOKEN_ISSUER=http://localhost:3000
# 発行するJWTの aud (任意。設定しない場合 aud クレームは含まれない)
TOKEN_AUDIENCE=

# 許可ドメイン設定
ALLOWED_DOMAIN=g.chuo-u.ac.jp

# Google Cloud OAuth設定
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# JWT署名鍵設定 (pnpm generate-keys の出力を貼り付ける)
# 改行は \n でエスケープして1行で記述する。PKCS#8 / PKCS#1 どちらの秘密鍵も可
# JWT_PUBLIC_KEY は省略可能 (秘密鍵から導出。指定した場合は秘密鍵と一致するか検証する)
JWT_KEY_ID=chuoauth-primary-key
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"

# ログインフロー中の状態クッキーを暗号化する秘密値 (32文字以上)
SESSION_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# 許可する外部リダイレクトURI (カンマ区切り、完全一致で照合)
# /api/verify のCORS許可オリジンもここから導出する
ALLOWED_REDIRECT_URIS=http://localhost:5173/callback,https://my-app.example.com/callback
